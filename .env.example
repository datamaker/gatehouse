# ── gatehouse configuration ─────────────────────────────────────────────────
# Copy to `.env` and fill in. Generate secrets with the commands shown.
# Never commit your real .env — it is gitignored.

# Public URL this gateway is reached at (used to build OAuth redirect URIs).
GATEHOUSE_PUBLIC_URL=https://auth.example.com

# Google OAuth 2.0 credentials (Google Cloud Console → Credentials → OAuth client).
# Add "<GATEHOUSE_PUBLIC_URL>/callback" as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Workspace domains allowed to sign in (comma-separated).
GATEHOUSE_ALLOWED_DOMAINS=example.com

# Emails that receive admin rights on login (comma-separated). Empty = no admins.
GATEHOUSE_ADMIN_EMAILS=

# Session cookie domain, e.g. example.com so the cookie is shared across
# subdomains. Leave unset for a host-only cookie.
GATEHOUSE_COOKIE_DOMAIN=

# Secret used to sign the state/session cookies. REQUIRED over HTTPS.
#   openssl rand -base64 32
GATEHOUSE_COOKIE_SECRET=

# Session lifetime (sliding): idle timeout, absolute cap since login, and how often
# activity is written back (minutes). A weekday-long idle window means one login a week.
GATEHOUSE_SESSION_IDLE_HOURS=24
GATEHOUSE_SESSION_MAX_HOURS=168
GATEHOUSE_SESSION_TOUCH_MINUTES=10

# Domains that a post-login `rd` redirect may target (comma-separated).
# Defaults to the cookie + allowed domains when unset.
GATEHOUSE_REDIRECT_DOMAINS=

# Shared secret for GET /internal/account (apps with their own sessions/tokens ask
# whether an account is still active / when it was last revoked). Unset = route is 404.
#   openssl rand -base64 32
GATEHOUSE_INTERNAL_SECRET=

# Zero trust (ward device posture). See README for the full GATEHOUSE_ZT_* list.
# Enforce for these users only while the global mode stays `monitor` (comma-separated emails).
GATEHOUSE_ZT_ENFORCE_EMAILS=
# "Restricted, not blocked" hosts (comma-separated, `*.` wildcard ok). Under enforce a failing device still gets 200
# from /auth/verify, with `X-Auth-Device-Restricted: 1` so the app can limit the session (e.g. the ward console).
GATEHOUSE_ZT_SOFT_HOSTS=
# OIDC client_ids never blocked by the device check at login (device-grant clients are always exempt).
GATEHOUSE_ZT_OIDC_EXEMPT_CLIENTS=

# PostgreSQL connection string.
DATABASE_URL=postgres://gatehouse:change-me@localhost:5435/gatehouse
# Password for the bundled Postgres container (docker-compose). Change it.
POSTGRES_PASSWORD=change-me

# Server bind + logging (optional).
PORT=9100
HOST=0.0.0.0
LOG_LEVEL=info
